    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3010",
      "type": "text"
    },
    {
      "key": "token",
      "value": "",
      "type": "secret"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "text"
    },
    {
      "key": "password",
      "value": "admin123",
      "type": "secret"
    },
    {
      "key": "today",
      "value": "2024-01-15",
      "type": "text",
      "description": "Fecha para consultar eventos del calendario (YYYY-MM-DD)"
    },
    {
      "key": "event_id",
      "value": "",
      "type": "text",
      "description": "UUID del evento del calendario"
    },
    {
      "key": "content_id",
      "value": "",
      "type": "text",
      "description": "ID de contenido (canal, película o serie)"
    },
    {
      "key": "serie_name",
      "value": "",
      "type": "text",
      "description": "Nombre de la serie para obtener episodios"
    },
    {
      "key": "channel_provider_id",
      "value": "",
      "type": "text",
      "description": "Provider ID del canal para favoritos"
    },
    {
      "key": "stream_id",
      "value": "1",
      "type": "text",
      "description": "ID del stream para proxy"
    },
    {
      "key": "search_query",
      "value": "football",
      "type": "text",
      "description": "Texto de búsqueda"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('token', jsonData.access_token);",
                  "    console.log('Token guardado:', jsonData.access_token);",
                  "}",
                  "",
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Token recibido', function() {",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('token', '');",
                  "console.log('Token limpiado');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "session"]
            }
          }
        }
      ]
    },
