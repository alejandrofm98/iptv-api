{
  "info": {
    "_postman_id": "iptv-api-v2.1",
    "name": "IPTV API v2.1",
    "description": "API para gestión de usuarios IPTV",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "text"
    },
    {
      "key": "token",
      "value": "",
      "type": "secret"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "text"
    },
    {
      "key": "password",
      "value": "admin123",
      "type": "secret"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('token', jsonData.access_token);",
                  "    console.log('Token guardado:', jsonData.access_token);",
                  "}",
                  "",
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Token recibido', function() {",
                  "    pm.expect(jsonData).to.have.property('access_token');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          }
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('token', '');",
                  "console.log('Token limpiado');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "session"]
            }
          }
        }
      ]
    },
    {
      "name": "Content - Groups",
      "item": [
        {
          "name": "Listar grupos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/content/groups?content_type=channels",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content", "groups"],
              "query": [
                {
                  "key": "content_type",
                  "value": "channels"
                }
              ]
            }
          }
        },
        {
          "name": "Grupos filtrados por países",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/content/groups?content_type=channels&countries=US,MX,ES",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content", "groups"],
              "query": [
                {
                  "key": "content_type",
                  "value": "channels"
                },
                {
                  "key": "countries",
                  "value": "US,MX,ES"
                }
              ]
            }
          }
        },
        {
          "name": "Grupos de películas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/content/groups?content_type=movies",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content", "groups"],
              "query": [
                {
                  "key": "content_type",
                  "value": "movies"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Content - Countries",
      "item": [
        {
          "name": "Listar países",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/content/countries?content_type=channels",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content", "countries"],
              "query": [
                {
                  "key": "content_type",
                  "value": "channels"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Content - Lista",
      "item": [
        {
          "name": "Listar canales",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/content?content_type=channels&page=1&page_size=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content"],
              "query": [
                {
                  "key": "content_type",
                  "value": "channels"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Listar películas con filtros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/content?content_type=movies&group=Action&country=US",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content"],
              "query": [
                {
                  "key": "content_type",
                  "value": "movies"
                },
                {
                  "key": "group",
                  "value": "Action"
                },
                {
                  "key": "country",
                  "value": "US"
                }
              ]
            }
          }
        },
        {
          "name": "Item específico",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/content/movies/12345",
              "host": ["{{baseUrl}}"],
              "path": ["api", "content", "movies", "12345"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Users",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"usuario1\",\n  \"password\": \"password123\",\n  \"max_connections\": 2,\n  \"role\": \"user\"\n}"
            }
          }
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users?page=1&page_size=50",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "page_size",
                  "value": "50"
                }
              ]
            }
          }
        },
        {
          "name": "Obtener usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{user_id}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{user_id}"]
            }
          }
        },
        {
          "name": "Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{user_id}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{user_id}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"max_connections\": 5,\n  \"is_active\": true\n}"
            }
          }
        },
        {
          "name": "Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{user_id}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{user_id}"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Devices",
      "item": [
        {
          "name": "Dispositivos de usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{user_id}/devices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{user_id}", "devices"]
            }
          }
        },
        {
          "name": "Todas las sesiones",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
