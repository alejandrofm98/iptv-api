            }
          }
        },
        {
          "name": "Desconectar dispositivo",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{user_id}/devices/{device_id}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{user_id}", "devices", "{device_id}"]
            }
          }
        },
        {
          "name": "Desconectar todos",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/users/{user_id}/devices",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "users", "{user_id}", "devices"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Stats",
      "item": [
        {
          "name": "Estadísticas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/stats",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Content",
      "item": [
        {
          "name": "Recargar template",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/content/reload",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "content", "reload"]
            }
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}"
      }
    ]
  }
}
