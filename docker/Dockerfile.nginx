# Dockerfile para Nginx con configuración embebida
# Esto asegura que nginx.conf se incluya en la imagen y no dependa de volúmenes
FROM nginx:alpine

# Copiar configuración personalizada desde la carpeta nginx/
COPY nginx/nginx.conf /etc/nginx/nginx.conf

# Los certificados SSL se montan como volumen, no se copian en la imagen

# Verificar configuración al construir
RUN nginx -t

# Puerto por defecto
EXPOSE 80

# Comando por defecto
CMD ["nginx", "-g", "daemon off;"]
